# ---------------------------------------------------------------------------
# Plateboard frontend - environment configuration
# Copy this file to `frontend/.env` and adjust as needed.
#
# Next.js loads .env files automatically. Variables WITHOUT the NEXT_PUBLIC_
# prefix are available on the server side only (next.config.ts, rewrites, SSR);
# only NEXT_PUBLIC_* variables reach the browser bundle.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend, used by the /api proxy (rewrites) in
# next.config.ts during `next dev` and by the standalone server. It is NOT
# shipped to the browser: the UI always fetches the relative /api/* path.
# Resolved when the config is evaluated (dev start / `npm run build`) for the
# rewrite, and read again at *runtime* by the server-rendered dish list (`/`),
# which calls the backend directly from the Next server. A real environment
# variable set for `node .next/standalone/server.js` overrides this file.
API_ORIGIN=http://127.0.0.1:8000

# Note on ports: neither `next dev` nor the standalone server reads
# HOSTNAME/PORT from this file. Set them as shell variables instead:
#   next dev --port 4000 (or PORT=4000 next dev)
#   HOSTNAME=127.0.0.1 PORT=3000 node .next/standalone/server.js
