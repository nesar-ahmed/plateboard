# ---------------------------------------------------------------------------
# Plateboard backend - environment configuration
#
# Copy this file to `backend/.env` and adjust as needed. Every value below is
# OPTIONAL; the defaults shown already match app/core/config.py, so an exact
# copy runs locally with zero changes. Real environment variables (used by
# tests, pm2, Docker) override anything here.
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
APP_NAME=Plateboard API
APP_VERSION=0.1.0
# local | test | staging | production  (production also hides /docs + OpenAPI)
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
ROOT_PATH=

# --- database (SQLite by default) -----------------------------------------
# Relative paths resolve against the backend directory, so ./plateboard.db
# always means backend/plateboard.db. Swap in any SQLAlchemy URL, e.g.
#   postgres+asyncpg://user:pass@localhost:5432/plateboard
DATABASE_URL=sqlite+aiosqlite:///./plateboard.db
DATABASE_ECHO=false
SQL_ECHO=false

# --- http ------------------------------------------------------------------
# Comma-separated list or JSON array. Only needed when a browser calls the API
# cross-origin (e.g. `next dev` on :3000 hitting the API directly). Behind an
# nginx same-origin proxy you can set CORS_ORIGINS= (empty).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_X_FORWARDED_HOST=false

# --- sessions --------------------------------------------------------------
# Server-side sessions (table `sessions`) carried in an HTTP-only cookie.
SESSION_COOKIE_NAME=plateboard_session
SESSION_TTL_DAYS=7

# --- observability ---------------------------------------------------------
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
LOG_JSON=false
